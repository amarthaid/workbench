PORT=3000
# 64 hex chars (32 bytes) — required; generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# SQLite file path (default), or a postgres:// / postgresql:// URL to use PostgreSQL.
DATABASE_URL=./data/tokens.db
# DATABASE_URL=postgres://user:pass@localhost:5432/workbench
PLUGINS_DIR=./plugins
AUDIT_LOG_DEST=sqlite

# Google Workspace SSO (optional — portal login)
# Redirect URI to register in GCP: ${PORTAL_URL}/auth/google/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Plugin OAuth — each plugin owns its own OAuth client.
# Naming convention: <PLUGIN_NAME_UPPER_SNAKE>_CLIENT_ID / _SECRET
# (e.g. google-gmail → GOOGLE_GMAIL_CLIENT_ID)
# Each plugin's redirect URI in its provider's console:
#   ${SERVER_PUBLIC_URL}/api/auth/plugin/<plugin-name>/callback

# --- Google plugins (each = separate GCP OAuth client) ---
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_GEMINI_CLIENT_ID=
GOOGLE_GEMINI_CLIENT_SECRET=
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GOOGLE_SLIDES_CLIENT_ID=
GOOGLE_SLIDES_CLIENT_SECRET=

# --- Other providers (separate OAuth clients in their consoles) ---
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=
# SLACK_CLIENT_ID= / SLACK_CLIENT_SECRET=
# ATLASSIAN_JIRA_CLIENT_ID= / ATLASSIAN_JIRA_CLIENT_SECRET=
# ATLASSIAN_CONFLUENCE_CLIENT_ID= / ATLASSIAN_CONFLUENCE_CLIENT_SECRET=
# ATLASSIAN_BITBUCKET_CLIENT_ID= / ATLASSIAN_BITBUCKET_CLIENT_SECRET=
# ASANA_CLIENT_ID= / ASANA_CLIENT_SECRET=

# Cluster mode: fork os.availableParallelism() workers to use all CPU cores.
# Requires PostgreSQL — SQLite cannot be safely shared across processes.
# CLUSTER_ENABLED=true

# 32+ character secret for JWT signing — required; generate with: openssl rand -base64 32
SESSION_SECRET=random-32-char-min-secret-for-jwt-signing
PORTAL_URL=http://localhost:5173
SERVER_PUBLIC_URL=http://localhost:3000

# TTL (seconds) for pending connections and abandoned cookie login sessions
# before the background reaper closes them. Default: 600 (10 min).
CONNECT_TTL_SECONDS=600

# --- Agent file workspace ---
# Where per-user agent files live. Give this its own mount: in a multi-replica
# deployment it must be read-write-many so every pod sees the same files, and it
# must NOT share a volume with the database — a full workspace would otherwise
# take tokens.db down with it.
WORKSPACE_DIR=./data/workspace
# Retention is age only: a file is deleted this many hours after it is written,
# whether or not anything is using it, and reading does not extend its life.
WORKSPACE_TTL_HOURS=24
# Per-file cap (bytes). Default 100MB.
WORKSPACE_MAX_FILE_BYTES=104857600
# Per-user quota (bytes). Default 256MB.
WORKSPACE_MAX_BYTES_PER_USER=268435456
# Lifetime of a presigned workspace URL (seconds). The token travels in the URL
# and so reaches access logs — keep this short.
WORKSPACE_PRESIGN_TTL_SECONDS=300
