{
  "name": "a-workbench",
  "version": "0.31.0-rc.4",
  "private": true,
  "packageManager": "npm@10.2.0",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:docs": "node --test docs/site/test/*.test.mjs",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "marked": "^16.4.2",
    "turbo": "^2.11.4"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "engines": {
    "node": ">=22"
  }
}
